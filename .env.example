# Browser-side Supabase access for the athlete's own rows.
# The publishable key is safe to ship in the bundle: row-level security limits it
# to the signed-in athlete's own athlete_profiles / athlete_strength_entries rows
# plus read-only reference tables. The service-role key must never appear here.
VITE_SUPABASE_URL=https://qiccnqkypbhlwpmjcsri.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Higgsfield generation tool (scripts/higgsfield). Server-side only: the complete
# API key copied from open.higgsfield.ai/api-keys, pasted as-is. Never ship it
# to the browser or commit it.
HF_API_KEY=
# Optional; defaults to https://api.higgsfield.ai
HF_API_BASE_URL=
