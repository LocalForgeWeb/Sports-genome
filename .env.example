# --- Server ---------------------------------------------------------------
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# --- Shared (client + server) ---------------------------------------------
VITE_APP_ID=
VITE_OAUTH_PORTAL_URL=

# --- iOS app --------------------------------------------------------------
# Absolute origin of the deployed API. REQUIRED for the native build: the app
# bundle is served from capacitor://localhost and has no /api of its own, so a
# relative URL cannot work. Baked in at `pnpm build:client` time — rebuild and
# re-sync after changing it. Leave unset for web, where relative URLs are right.
VITE_API_BASE_URL=

# Custom URL scheme the app registers for the OAuth hand-back. Must match the
# CFBundleURLSchemes entry in ios/App/App/Info.plist. Server-side value: the
# OAuth callback only ever redirects here, never to a scheme from the request.
NATIVE_APP_SCHEME=sportsgenome
VITE_NATIVE_APP_SCHEME=sportsgenome

# Extra browser origins allowed to call the API with credentials (comma
# separated). The native webview origins are always allowed; this is for
# additional web deployments.
ALLOWED_ORIGINS=
