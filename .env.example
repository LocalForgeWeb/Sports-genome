# Browser-side Supabase access for the athlete's own rows.
# The publishable key is safe to ship in the bundle: row-level security limits it
# to the signed-in athlete's own athlete_profiles / athlete_strength_entries rows
# plus read-only reference tables. The service-role key must never appear here.
VITE_SUPABASE_URL=https://qiccnqkypbhlwpmjcsri.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Only a PRODUCTION build falls back to the production project when these are empty
# (client/src/lib/supabaseClient.ts). Local and preview builds get no Supabase client
# unless they are set here, so a test run cannot write into production by accident.
# For local work point them at a separate Supabase project, not production.

# ---- Server only (server/_core/config.ts classifies each one; never VITE_-prefixed) ----

# Required in production: the server's Supabase key (evidence library, ranks, shares,
# shared rate limits). The server reads the project URL from VITE_SUPABASE_URL above.
# Never paste the production value into a local file that leaves your machine.
SUPABASE_SERVICE_ROLE_KEY=

# Optional: MySQL for account sign-in and account workout logs. Absent = those routes
# answer "unavailable"; production does not set it today (sign-in is not in the build).
DATABASE_URL=

# Optional: a long random string. Unlocks GET /api/health/ready (header x-health-token)
# for an uptime monitor; without it that path is a 404. /api/health needs nothing.
HEALTH_CHECK_TOKEN=

# Optional: "off" turns the cross-instance rate limit off (per-instance limits stay).
RATE_LIMIT_SHARED=

# Local only: "memory" keeps shared-workout links in memory. Ignored in production.
SHARE_STORE=

# Higgsfield generation tool (scripts/higgsfield). Server-side only: the complete
# API key copied from open.higgsfield.ai/api-keys, pasted as-is. Never ship it
# to the browser or commit it.
HF_API_KEY=
# Optional; defaults to https://api.higgsfield.ai
HF_API_BASE_URL=
